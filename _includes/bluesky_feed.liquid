<!-- Bluesky feed sidebar: posts are fetched in the browser from the public Bluesky API -->
{% assign bsky_limit = include.limit | default: 8 %}
<aside class="bsky-feed" aria-labelledby="bsky-feed-title">
  <div class="bsky-feed-header">
    <h2 id="bsky-feed-title">
      <a href="https://bsky.app/profile/{{ include.handle }}" target="_blank" rel="noopener noreferrer">bluesky</a>
    </h2>
    <a class="bsky-feed-follow" href="https://bsky.app/profile/{{ include.handle }}" target="_blank" rel="noopener noreferrer"
      >@{{ include.handle -}}
    </a>
  </div>
  <ol class="bsky-feed-list" data-bsky-handle="{{ include.handle }}" data-bsky-limit="{{ bsky_limit }}">
    <li class="bsky-feed-status">Loading posts…</li>
  </ol>
  <noscript>
    <p class="bsky-feed-status">See my posts on <a href="https://bsky.app/profile/{{ include.handle }}">Bluesky</a>.</p>
  </noscript>
</aside>
<script defer src="{{ '/assets/js/bluesky-feed.js' | relative_url | bust_file_cache }}"></script>
